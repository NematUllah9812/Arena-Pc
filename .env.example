# ─── Supabase (omit all three → in-memory demo repository) ───────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only — never prefix with NEXT_PUBLIC_

# ─── Stealth /admin perimeter (§7) ──────────────────────────────────────────
ADMIN_STEALTH_KNOCK_SECRET=         # ≥16 chars. Visit /admin?knock=<secret> to receive the cloak cookie
ADMIN_KNOCK_TOTP_SECRET=            # optional base32: accept a rotating 6-digit knock instead
ADMIN_ALLOWED_IPS=                  # optional CSV; trailing * wildcard (e.g. 203.0.113.*)
ADMIN_CLOAK_COOKIE_SECRET=          # optional; defaults to SESSION_SECRET
ADMIN_BOOTSTRAP_TOKEN=              # ≥16 chars; enrolls the first OVERSEER while the vault is empty
SESSION_SECRET=                     # ≥32 chars; signs vault sessions / invites (HS256)
VAULT_ENCRYPTION_KEY=               # high-entropy; AES-GCM seals TOTP secrets at rest
WEBAUTHN_RP_ID=                     # optional; defaults to request host (pin to your prod domain)
WEBAUTHN_ORIGIN=                    # optional; defaults to https://<host>

# ─── Ops ────────────────────────────────────────────────────────────────────
CRON_SECRET=                        # Vercel Cron sends Authorization: Bearer <CRON_SECRET>
UPSTASH_REDIS_REST_URL=             # optional; falls back to in-process sliding window
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_SITE_URL=https://vortexlabs.gg
